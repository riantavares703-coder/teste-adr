{
  "name": "plataforma-pedidos",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/launcher.mjs",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:domain": "pnpm --filter @plataforma/domain test",
    "test:api": "pnpm --filter @plataforma/api test",
    "db:start": "./scripts/db-start.sh",
    "db:migrate": "pnpm --filter @plataforma/api db:migrate",
    "db:seed": "pnpm --filter @plataforma/api db:seed",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
